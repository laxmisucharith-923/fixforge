# GitHub — required for fetching issues and cloning private repos
GITHUB_TOKEN=ghp_your_github_token_here

# LLM — required for fix generation
LLM_API_KEY=your_llm_api_key_here

# Provider: groq | deepseek | anthropic | openai
LLM_PROVIDER=groq

# Optional model override
# LLM_MODEL=llama-3.3-70b-versatile

LOG_LEVEL=INFO
